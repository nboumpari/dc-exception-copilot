# Copy to .env and fill in. Never commit .env.

# LLM provider: "openai" or "azure"
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI (only if LLM_PROVIDER=azure)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# LangSmith tracing and evaluation (https://smith.langchain.com)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=dc-exception-copilot
# EU-region accounts use https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Contact string sent in the User-Agent when downloading the corpus
CORPUS_CONTACT=your-email@example.com
